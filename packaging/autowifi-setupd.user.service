[Unit]
Description=Autowifi encrypted BLE setup daemon
Documentation=https://github.com/enfipy/autowifi

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/autowifi
ExecStart=/usr/bin/python3 %h/.local/lib/autowifi/autowifi_setupd.py
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
